<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 맥에 로그인하면 AI 일꾼을 띄우고, 죽으면 다시 띄운다.
       스크립트는 iCloud 폴더(Mobile Documents) 밖 ~/.yakktime/ 에 복사해 둔 것을 쓴다 — launchd 가 띄운 프로그램은
       iCloud 폴더를 못 연다(「Operation not permitted」, 2026-09-30 실측). setup_mac_worker.sh 가 복사한다.
       넣기:  sh tools/setup_mac_worker.sh   빼기:  launchctl unload ~/Library/LaunchAgents/com.yakktime.aiworker.plist
       기록:  ~/Library/Logs/yakktime-ai-worker.log -->
  <key>Label</key><string>com.yakktime.aiworker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/yangseunghun/.yakktime/ai_worker.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/Users/yangseunghun/.local/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>/Users/yangseunghun/Library/Logs/yakktime-ai-worker.out.log</string>
  <key>StandardErrorPath</key><string>/Users/yangseunghun/Library/Logs/yakktime-ai-worker.err.log</string>
</dict>
</plist>
